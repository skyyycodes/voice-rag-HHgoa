# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Speech to text (pick one; Sarvam is the default) ---------------------
# https://dashboard.sarvam.ai — Saaras ASR, built for Indic languages.
SARVAM_API_KEY=
# Optional second provider. When set, the harness fails over to it if Sarvam
# is down or rate-limited.
ELEVENLABS_API_KEY=

# --- Optional LLM answer path ---------------------------------------------
# Without this the system runs extractive-only, which is the path benchmarked
# against the 200ms target. Leave blank for a fully local pipeline.
# Either enables the optional 'llm' answer mode. Groq's free tier is enough.
# Anthropic wins if both are set; pin VRAG_LLM_PROVIDER to override.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Overrides (all optional; defaults live in src/vrag/config.py) --------
# VRAG_LANGUAGES=["hin","ben","tam"]
# VRAG_MAX_ROWS_PER_LANG=1200
# VRAG_ANSWER_MODE=extractive
# VRAG_ONNX_THREADS=4
# Point at a pre-fetched model directory to skip the Hub entirely at boot.
# VRAG_LOCAL_ENCODER_PATH=
# VRAG_LOCAL_TOKENIZER_PATH=
